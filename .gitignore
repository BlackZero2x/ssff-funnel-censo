# ══════════════════════════════════════════════════════
#  .gitignore — Proyecto SSFF
#  NO subir: credenciales, datos sensibles, temporales
# ══════════════════════════════════════════════════════

# ── Documentación interna (solo local, nunca subir) ───
CLAUDE.md
ANALISIS_METODOLOGIAS_MAYO_2026.md

# ── Credenciales y configuración sensible ─────────────
.env
*.json          # token.json, credentials.json
*.key

# ── Archivos de datos (grandes o confidenciales) ───────
*.csv
*.xlsx
*.xls
temp_capturas/

# ── Logs ───────────────────────────────────────────────
*.log

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Entornos virtuales ─────────────────────────────────
venv/
env/
.venv/
.env/

# ── IDEs y editores ────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
Thumbs.db
Desktop.ini

# ── WhatsApp Server (Reportes_ssff_wsp) ───────────────
Reportes_ssff_wsp/session_data/
Reportes_ssff_wsp/logs/
Reportes_ssff_wsp/.node-persist
Reportes_ssff_wsp/.wwebjs_cache
Reportes_ssff_wsp/node_modules/
Reportes_ssff_wsp/__pycache__/
Reportes_ssff_wsp/config.json      # Nunca subir config real con IDs
Reportes_ssff_wsp/DIRECTORIO_MENCIONES.md  # Datos sensibles

# ── Outputs regenerables de los cortes de ventas ──────
Reportes_ssff_wsp/cache/
Reportes_ssff_wsp/cortes_imagenes/
Reportes_ssff_wsp/CORTE_ALERTAS_*.json
Reportes_ssff_wsp/CORTE_VENTAS_*.xlsx
funnel_imagenes/
historico_SFavances/
tablas_jesus_diario/
